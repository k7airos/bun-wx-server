{
  "name": "blog-wx-bun-service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts serve",
    "start": "bun src/index.ts serve",
    "serve": "bun src/index.ts serve",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "lint": "bunx eslint .",
    "migrate": "bun src/index.ts migrate",
    "init-admin": "bun src/index.ts init-admin",
    "backup": "bun src/index.ts backup",
    "restore": "bun src/index.ts restore",
    "check-config": "bun src/index.ts check-config",
    "test": "bun test",
    "check": "bun test && bun src/index.ts --help && bun src/index.ts check-config",
    "build:binary": "mkdir -p dist && bun build ./src/index.ts --compile --outfile ./dist/blog-wx-bun-service",
    "build:bundle": "mkdir -p dist && bun build ./src/index.ts --outfile ./dist/index.js",
    "release:patch": "changelogen --release --patch --push",
    "release:minor": "changelogen --release --minor --push",
    "release:major": "changelogen --release --major --push"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.3.12",
    "changelogen": "^0.6.2",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
